    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev",
            ],
            "cwd": "${workspaceFolder}/backend"
            // "jinja": true
        },
        {
            "name": "Python Debugger: Pytest testinit.py",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test/testinit.py"
            ],
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}