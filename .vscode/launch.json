{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "ViteJS Dev",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "cwd": "${workspaceFolder}/frontend/app",
        "console": "integratedTerminal"
      },
      {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev",
            ],
            "cwd": "${workspaceFolder}/backend"
            // "jinja": true
        },
        {
            "name": "Python Debugger: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "test/testinit.py",
                "-s"
            ],
            "cwd": "${workspaceFolder}/backend"
        }
    ]
  }